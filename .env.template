# Application
APP_ENV=development
APP_NAME=consultor-organizacional-autonomo
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# Data source: jsonl for raw V2, duckdb for the local analytical store, postgres for a real shared source.
DATA_SOURCE=postgres
ALLOW_SYNTHETIC_DATA=false
DATA_ROOT=data
RAW_EVENT_LOG_PATH=data/raw/event_log_v2.jsonl
TAXONOMY_PATH=data/raw/business_taxonomy_v2.json
ORG_CHART_PATH=data/raw/org_chart_declared_v2.json
POLICY_PATH=config/policies.json
DUCKDB_PATH=data/derived/organizational_events_v2.duckdb

# PostgreSQL. Replace all placeholder values in deployed environments.
POSTGRES_DB=organization_restructuring
POSTGRES_USER=restructure_app
POSTGRES_PASSWORD=replace_with_a_strong_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://restructure_app:replace_with_a_strong_secret@localhost:5432/organization_restructuring
DB_READ_ONLY=true
DB_CONNECT_TIMEOUT_SECONDS=10
DB_EVENTS_TABLE=events
DB_TAXONOMY_TABLE=business_taxonomy
DB_ORG_TEAMS_TABLE=org_teams
DB_ORG_MEMBERS_TABLE=org_members

# LLM. Use an OpenAI-compatible endpoint. Keep disabled until a real key is supplied.
LLM_ENABLED=false
LLM_PROVIDER=ollama_openai_compatible
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss:20b
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0
LLM_STRUCTURED_OUTPUTS=true

# Safety, policies and observability
POLICY_MODE=enforced
POLICY_REQUIRE_EVIDENCE=true
POLICY_ALLOW_MACRO_CHANGE=true
POLICY_MAX_ANNUAL_COST=100000000
TRACE_ENABLED=true
TRACE_INCLUDE_TOOL_RESULTS=true
TRACE_INCLUDE_PAYLOADS=false
